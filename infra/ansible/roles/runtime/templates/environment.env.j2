# Managed by Ansible (infra/ansible/roles/runtime). Do not edit on the host:
# change the SSM parameters under /roombook/{{ environment_name }}/app/ and
# re-run infra/scripts/configure-hosts.ps1.
#
# Read by deploy/compose/stack.yml for the {{ environment_name }} environment.

POSTGRES_USER=roombook
POSTGRES_DB=roombook
POSTGRES_PASSWORD={{ postgres_password }}

ROOMBOOK_ENVIRONMENT={{ environment_name }}
ROOMBOOK_DATABASE_URL=postgresql+psycopg://roombook:{{ postgres_password }}@db:5432/roombook

# Application settings from SSM Parameter Store ({{ app_settings | length }} found).
{% for parameter in app_settings | sort(attribute='Name') %}
{{ parameter.Name | basename }}={{ parameter.Value }}
{% endfor %}
