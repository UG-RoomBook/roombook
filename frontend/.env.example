# Real API mode is the default. Vite proxies API requests to this local backend.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Optional cross-origin API base URL. Leave empty for the same-origin proxy.
VITE_API_BASE_URL=

# Local sample data only. This option has no effect in a production build.
VITE_ENABLE_MOCKS=false
