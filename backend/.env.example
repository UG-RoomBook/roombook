# Local development only. The Compose database listens on loopback port 5433.
ROOMBOOK_DATABASE_URL=postgresql+psycopg://roombook:roombook@127.0.0.1:5433/roombook
ROOMBOOK_ENVIRONMENT=development
ROOMBOOK_VERSION=0.1.0
ROOMBOOK_COMMIT_SHA=unknown
# Tests refuse to reset a database whose name does not end in _test.
ROOMBOOK_TEST_DATABASE_URL=postgresql+psycopg://roombook:roombook@127.0.0.1:5433/roombook_test

# RB-45 foundations. Enable only after protected provider configuration is supplied.
ROOMBOOK_AUTH_ENABLED=false
# ROOMBOOK_AUTH_SUPABASE_URL=https://your-project.supabase.co
# ROOMBOOK_AUTH_SUPABASE_PUBLISHABLE_KEY=<provider publishable key, server configuration>
# ROOMBOOK_AUTH_TOKEN_ENCRYPTION_KEY=<separate Fernet key for this environment>
# ROOMBOOK_AUTH_SITE_URL=https://roombook-staging.zenora.dev
ROOMBOOK_AUTH_COOKIE_SECURE=true
ROOMBOOK_AUTH_IDLE_SECONDS=1800
ROOMBOOK_AUTH_ABSOLUTE_SECONDS=43200
ROOMBOOK_AUTH_REVALIDATE_SECONDS=300
# Loopback HTTP development only: explicitly set COOKIE_SECURE=false and use the
# exact local origin (for example http://127.0.0.1:5174). Never use that in Staging/Production.
