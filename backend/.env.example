# Local development only. The Compose database listens on loopback port 5433.
ROOMBOOK_DATABASE_URL=postgresql+psycopg://roombook:roombook@127.0.0.1:5433/roombook
ROOMBOOK_ENVIRONMENT=development
ROOMBOOK_VERSION=0.1.0
ROOMBOOK_COMMIT_SHA=unknown
# Tests refuse to reset a database whose name does not end in _test.
ROOMBOOK_TEST_DATABASE_URL=postgresql+psycopg://roombook:roombook@127.0.0.1:5433/roombook_test
