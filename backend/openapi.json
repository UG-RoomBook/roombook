                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Account service unavailable"
          }
        },
        "security": [
          {
            "SessionCookie": []
          }
        ],
        "summary": "Logout",
        "tags": [
          "Identity"
        ]
      }
    },
